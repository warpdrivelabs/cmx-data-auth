# cmx-dataauth-server 本地启动配置示例。复制为 data-auth-server.toml（勿提交含密钥的真实配置）。
# 框架级字段（host/port/log）走 [server] 段（chassis 读）；业务字段走 [auth]/[datasource]（本 bin 读）。

[server]
host = "0.0.0.0"
port = 8096
log_dir = "logs"
log_level = "info"

[auth]
# off（默认，本地信任、含管理面放行，仅供开发）| jwt。生产禁 off。
mode = "off"
# jwt 模式：令牌必须携带 exp 且被校验；拒绝默认/空密钥（须改此值）。
# jwt_secret = "change-me"
# jwt_tenant_claim = "tenant"
# jwt_roles_claim = "roles"
# api_keys = "key1:tenantA,key2:tenantB"
# single（默认）| multi（每租户一库 dataauth_<tenant>）
tenancy = "single"
# 以下两项仅经环境变量配置（env-only）：
#   DATAAUTH_ADMIN_ROLES      管理面所需角色（默认 superadmin,admin,dataauth-admin）
#   DATAAUTH_ALLOWED_TENANTS  JWT tenant claim 白名单（空=不限制）

[datasource]
dataauth_pg_url = "postgres://postgres:postgres@127.0.0.1:5432/fico"
